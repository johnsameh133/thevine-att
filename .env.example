# Copy this file to .env and fill in the values. Never commit .env.
# Use single quotes around a value if it contains $, # or spaces.

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD='change-me-to-a-long-password'

# Where each scan is POSTed (use your production webhook URL)
WEBHOOK_URL=https://your-n8n-domain/webhook/your-webhook-id

# Optional: secret used to sign login sessions. Set it so admins stay signed in
# after a restart. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: set to true when behind a reverse proxy (Nginx, Caddy, Traefik) so
# login rate limiting uses the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# Optional: host port exposed by docker compose (default 3000)
HOST_PORT=3000
